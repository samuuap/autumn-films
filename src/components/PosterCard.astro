---
/** Un título en una rejilla de carteles: el de `/explorar` y el de «Más como esta». */
import { posterUrl } from '@/lib/tmdb';
import { CHAT_MODE_DEFINITIONS, type ContentType } from '@/lib/types';

interface Props {
  item: {
    readonly type: ContentType;
    readonly title: string;
    readonly year: number | null;
    readonly poster_path: string | null;
  };
  href: string;
  /** Solo los que se ven nada más abrir: diferir el resto ahorra datos. */
  eager?: boolean;
}

const { item, href, eager = false } = Astro.props;
const poster = posterUrl(item.poster_path, 'w342');
---

<a href={href} class="group block">
  <div
    class="bg-umber-surface ring-umber-surface group-hover:ring-umber-amber/70 group-focus-visible:ring-umber-amber relative aspect-[2/3] overflow-hidden rounded-lg ring-1 transition-shadow duration-300"
  >
    {
      poster === null ? (
        <div class="text-umber-ash flex h-full items-center justify-center p-3 text-center text-xs">Sin cartel</div>
      ) : (
        <img
          src={poster}
          alt=""
          width="342"
          height="513"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
        />
      )
    }
  </div>
  <p class="group-hover:text-umber-amber mt-2 line-clamp-2 text-sm leading-snug transition-colors">
    {item.title}
  </p>
  <p class="text-umber-ash mt-0.5 text-xs">
    {[item.year, CHAT_MODE_DEFINITIONS[item.type].label].filter((part) => part !== null).join(' · ')}
  </p>
</a>
