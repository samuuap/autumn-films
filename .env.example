# ─── DeepSeek ────────────────────────────────────────────────────────────────
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ─── Embeddings (Qwen3-Embedding-0.6B) ───────────────────────────────────────
# Cloudflare Workers AI (dash.cloudflare.com): el mismo modelo, gratis hasta
# 10.000 neuronas al día. Token con la plantilla «Workers AI» (Read y Edit).
EMBEDDINGS_URL=https://api.cloudflare.com/client/v4/accounts/<account-id>/ai/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=@cf/qwen/qwen3-embedding-0.6b
# Sin conexión, con el servidor local (npm run embeddings), en su lugar:
#   EMBEDDINGS_URL=http://127.0.0.1:8080/v1
#   EMBEDDINGS_API_KEY=
#   EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-0.6B

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API Keys
SUPABASE_URL=
# Dashboard: "Publishable key" (sb_publishable_...) o, en proyectos antiguos,
# "anon public" (eyJ...). Respeta RLS.
SUPABASE_PUBLISHABLE_KEY=
# Dashboard: "Secret key" (sb_secret_...) o "service_role" (eyJ...). SE SALTA RLS.
# Solo scripts de seed y endpoints de servidor. NUNCA en el cliente.
SUPABASE_SECRET_KEY=

# ─── TMDB ────────────────────────────────────────────────────────────────────
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# ─── App ─────────────────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:4321
